{
  "mcpServers": {
    "agent-memory": {
      "command": "amem",
      "args": ["mcp"],
      "env": {
        "AMEM_SERVER_URL": "${user_config.server_url}",
        "AMEM_USER_KEY": "${user_config.user_key}",
        "AMEM_TEAM_ID": "${user_config.team_id}",
        "AMEM_AGENT_ID": "${user_config.agent_id}",
        "AMEM_DEPARTMENT_ID": "${user_config.department_id}"
      }
    }
  }
}
