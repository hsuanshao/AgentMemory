# Bearer token shared by memory-core and the panel BFF (required).
AGENT_MEMORY_API_KEY=replace-with-a-strong-random-token

# LLM used for L1/L2/L3 and skill extraction: provider openai (HTTP API) or cli.
AGENT_MEMORY_LLM_PROVIDER=openai
AGENT_MEMORY_LLM_BASE_URL=https://api.openai.com/v1
AGENT_MEMORY_LLM_API_KEY=
AGENT_MEMORY_LLM_MODEL=gpt-4o-mini
# provider=cli: the Docker image bundles Claude Code (claude) and Antigravity (agy).
#   Claude Code: COMMAND=claude ARGS=-p PROMPT_MODE=stdin (+ ANTHROPIC_API_KEY or /login)
#   Antigravity: COMMAND=agy ARGS='["-p","{prompt}"]' PROMPT_MODE=arg (log in once, see README)
AGENT_MEMORY_LLM_CLI_COMMAND=
AGENT_MEMORY_LLM_CLI_ARGS=
AGENT_MEMORY_LLM_CLI_PROMPT_MODE=stdin
# auto: memory-core turns off the CLI's own tools (claude, codex) before it reads
# conversation text. off: the args are passed as given. See docs/ops/DISTILLATION.md §6.
# ARGS that grant capability (--dangerously-*, --yolo, --allowedTools, ...) stop memory-core from starting.
AGENT_MEMORY_LLM_CLI_HARDENING=auto
ANTHROPIC_API_KEY=
# Host directory mounted at /workspace as the CLI's project (default ./workspace).
PROJECT_DIR=./workspace

# Optional embeddings (leave provider=none for BM25-only recall).
AGENT_MEMORY_EMBEDDING_PROVIDER=none
AGENT_MEMORY_EMBEDDING_BASE_URL=
AGENT_MEMORY_EMBEDDING_API_KEY=
AGENT_MEMORY_EMBEDDING_MODEL=
AGENT_MEMORY_EMBEDDING_DIMENSIONS=0
# Load (docs/ops/DISTILLATION.md §8).
# AGENT_MEMORY_EMBEDDING_TIMEOUT_MS=10000
# AGENT_MEMORY_EMBEDDING_MAX_CONCURRENCY=4
# AGENT_MEMORY_EMBEDDING_BACKFILL_INTERVAL_SECS=600
# AGENT_MEMORY_WORKER_CONCURRENCY=8
# AGENT_MEMORY_LLM_CLI_MAX_CONCURRENCY=2

# Secret redaction (docs/ops/DISTILLATION.md §7). Extra patterns are a JSON
# list; write $$ for a literal $ here, or use the config file instead.
AGENT_MEMORY_REDACTION_PASSWORD_SHAPE=true
# AGENT_MEMORY_REDACTION_PATTERNS=[{"kind":"tw-national-id","pattern":"\\b[A-Z][12]\\d{8}\\b"}]

CORE_DEPARTMENT_ID=default
CORE_PORT=8420
PANEL_PORT=8125
# Image tag of memory-core / memory-panel. Give each stack on one Docker host
# its own tag (e.g. v0.1.1) so rebuilding one never changes another.
MEMORY_IMAGE_TAG=local

# Storage: sqlite (default, one file per department) or postgres (pgvector).
# For postgres: AGENT_MEMORY_STORAGE_BACKEND=postgres, set POSTGRES_PASSWORD
# and run `docker compose --profile postgres up -d` (memory-core then uses
# postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB
# unless AGENT_MEMORY_POSTGRES_URL is set).
AGENT_MEMORY_STORAGE_BACKEND=sqlite
POSTGRES_USER=memory
POSTGRES_PASSWORD=
POSTGRES_DB=memory
